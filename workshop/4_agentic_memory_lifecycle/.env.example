# Workshop API credentials
# Replace these placeholders with actual keys if they are not already exported
# by your shell. Exported shell variables take precedence in the validator.
OPENAI_API_KEY=replace-me
TAVILY_API_KEY=replace-me

# Optional: Nebius Token Factory (disabled by default)
# To use Nebius, supply a Nebius API key in OPENAI_API_KEY and uncomment
# the settings below. setup.sh and the Mem0 container also need corresponding
# provider/embedding configuration; uncommenting alone is not sufficient.
# OPENAI_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# OPENAI_MODEL=moonshotai/Kimi-K2.6
# MEM0_DEFAULT_LLM_MODEL=moonshotai/Kimi-K2.6
# MEM0_DEFAULT_EMBEDDER_MODEL=<Nebius-supported-embedding-model-ID>